{
  "name": "speech2text",
  "version": "0.1.0",
  "author": "Scratch",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/openblock-plugin/speech2text.git"
  },
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "npx openblock-registry-cli dev",
    "build": "npx openblock-registry-cli build",
    "build:obfuscate": "npx openblock-registry-cli build --obfuscate",
    "publish": "npx openblock-registry-cli publish",
    "publish:dry": "npx openblock-registry-cli publish --dry-run",
    "validate": "npx openblock-registry-cli validate",
    "i18n:update": "npx openblock-registry-cli i18n update",
    "lint": "eslint . --ext .js --fix"
  },
  "openblock": {
    "name": {
      "formatMessage": {
        "id": "speech2text.name",
        "default": "Speech to Text"
      }
    },
    "extensionId": "speech2text",
    "arch": [
      "*"
    ],
    "programMode": [
      "realtime"
    ],
    "iconURL": "./assets/speech2text.png",
    "description": {
      "formatMessage": {
        "id": "speech2text.description",
        "default": "Talk to your projects."
      }
    },
    "internetConnectionRequired": true,
    "main": "./src/speech2text.js",
    "translations": "./src/translations.js",
    "tags": [
      "audio"
    ],
    "helpLink": "https://wiki.openblock.cc"
  },
  "dependencies": {
    "diff-match-patch": "1.0.4"
  },
  "devDependencies": {
    "eslint": "^5.3.0",
    "eslint-config-scratch": "^5.0.0",
    "husky": "^9.0.0"
  }
}
